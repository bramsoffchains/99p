{
  "manifest_version": 3,
  "key": "",
  "name": "99passwords",
  "version": "1.0.0",
  "description": "Fills logins from the 99passwords menu bar app. Your vault stays on your YubiKey.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Fill with 99passwords",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib.js",
        "page.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill or create a login for this site"
    }
  }
}
